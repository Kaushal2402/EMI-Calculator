# AdMob configuration (SOW §4.8, §13 D-07 · TASKS 7.2).
#
# Copy to `.env` and fill in PRODUCTION IDs for release builds:
#     cp .env.example .env
# `.env` and `.env.*` are git-ignored; only this template is committed.
#
# HOW THE VALUES ARE CONSUMED
#   • Dart (banner + interstitial unit IDs) — passed at build time via
#       flutter run   --dart-define-from-file=.env
#       flutter build appbundle --release --dart-define-from-file=.env
#     Read in lib/core/config/ad_config.dart. If the flag is omitted, Google's
#     public TEST unit IDs are used, so day-to-day `flutter run` / `flutter test`
#     need no .env.
#   • Native AdMob APPLICATION ID — Gradle/Xcode can't read Dart defines:
#       Android → android/app/build.gradle.kts parses this file for
#                 ADMOB_APP_ID_ANDROID (falls back to the test app ID).
#       iOS     → set ADMOB_APP_ID_IOS in ios/Flutter/Debug.xcconfig +
#                 Release.xcconfig (test app ID committed there by default).
#
# The values below are Google's PUBLIC test IDs — safe in dev, never billable.
# Replace every one for production.

# Android
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712

# iOS
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_IOS=ca-app-pub-3940256099942544/2934735716
ADMOB_INTERSTITIAL_IOS=ca-app-pub-3940256099942544/4411468910
